# Clés API des serveurs MCP déclarés dans .mcp.json
# Copier ce fichier en .env.local et remplir. Ne jamais committer les vraies clés.

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Firecrawl — https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Glif — https://glif.app/settings/api-tokens
GLIF_API_TOKEN=

# Higgsfield — https://cloud.higgsfield.ai/api-keys
HF_API_KEY=
HF_SECRET=

# Playwright ne demande aucune clé.
